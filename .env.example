# AgentSentinel configuration. Copy to .env (start.sh does this on first run).
# The defaults run the whole product offline: no API key, no internet.

# --- LLM safety judge --------------------------------------------------------
# mock | ollama | openai | gemini | anthropic
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=20

# Ollama (local models)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Hosted providers — only needed when AI_PROVIDER selects them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Database ----------------------------------------------------------------
# Leave empty for SQLite at data/agentsentinel.db.
# PostgreSQL: postgresql+psycopg://user:password@host:5432/agentsentinel  (pip install "psycopg[binary]")
DATABASE_URL=

# --- Gateway access -----------------------------------------------------------
# true = every external call to the gateway must carry the agent's session token.
# Turn this on before letting CI runners (or anything off-host) reach Sentinel.
# Issue tokens on the dashboard's "CI/CD Integration" page.
REQUIRE_AGENT_TOKEN=false

# --- Alerts ------------------------------------------------------------------
# Email and Slack are always simulated. A real webhook POST is sent only if this
# is set AND the webhook channel is enabled in Settings.
ALERT_WEBHOOK_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
